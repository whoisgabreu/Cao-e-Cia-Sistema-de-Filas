VETSOFT_BASE_URL=https://api.vetsoft.com.br
VETSOFT_TENANT=seu-tenant
VETSOFT_EMAIL=seu-email@exemplo.com
VETSOFT_PASSWORD=sua-senha

# Polling da fila (segundos)
SYNC_INTERVAL_SECONDS=15

# Credenciais de acesso por papel (variáveis do EasyPanel)
ADMIN_USER=admin
ADMIN_PASSWORD=mude-isto
RECEPCAO_USER=recepcao
RECEPCAO_PASSWORD=mude-isto
ATENDENTE_USER=atendente
ATENDENTE_PASSWORD=mude-isto

# Sessão (cookie assinado) — gere um valor aleatório e longo
SESSION_SECRET=troque-por-um-segredo-longo
SESSION_HOURS=12

# Banco SQLite
DB_PATH=queue.db
# Fuso do negócio (dia dos agendamentos)
BUSINESS_TZ=America/Sao_Paulo
